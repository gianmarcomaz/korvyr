# Korvyr configuration. Copy to `.env` and adjust; `.env` is git-ignored.
# Every value below is the built-in default, so an empty file behaves the same.

# ---------------------------------------------------------------------------
# Scanner API (korvyr.api.server)
# ---------------------------------------------------------------------------

# Port the FastAPI service binds to.
KORVYR_API_PORT=8000

# Path to the trained GNN checkpoint. NOT included in this repository - see
# "GNN checkpoint" in the README. If the file is missing, Korvyr runs in
# static-only mode (rules engine + manifest scanner, no GNN score).
KORVYR_MODEL_PATH=models/gnn_v2_cuda.pt

# true  -> refuse to start without a loadable checkpoint
# false -> start in static-only mode and report scan_mode="static-only"
KORVYR_REQUIRE_GNN=false

# Worker threads used to fan out lockfile scans.
KORVYR_MAX_WORKERS=4

# Largest tarball the API will accept, in bytes (50 MiB).
KORVYR_MAX_UPLOAD_BYTES=52428800

# Upstream registry used when downloading packages by name@version.
KORVYR_REGISTRY_URL=https://registry.npmjs.org

# Base URL the CLI talks to.
KORVYR_API_URL=http://localhost:8000

# Optional: append CPG build failures to this CSV for offline diagnostics.
# Unset (the default) means no file is written.
# KORVYR_CPG_FAILURE_LOG=data/diagnostics/cpg_build_failures.csv

# ---------------------------------------------------------------------------
# npm registry proxy (proxy/src/server.js)
# ---------------------------------------------------------------------------

KORVYR_PROXY_PORT=4873

# Where the proxy sends tarballs for scanning.
KORVYR_SCAN_API_URL=http://localhost:8000

# Milliseconds to wait for a scan before giving up.
KORVYR_SCAN_TIMEOUT=30000

# open   -> forward packages the scanner could not check (default; see the
#           fail-open limitation documented in the README)
# closed -> refuse packages the scanner could not check
KORVYR_FAIL_MODE=open

# Optional Redis URL for a shared verdict cache. Empty = in-memory only.
KORVYR_REDIS_URL=

# Verdict cache lifetime in seconds (24h).
KORVYR_CACHE_TTL=86400

# Largest tarball the proxy will buffer and scan, in bytes (50 MiB). Larger
# packages are handled according to KORVYR_FAIL_MODE.
KORVYR_MAX_TARBALL_SIZE=52428800

# debug | info | warn | error
KORVYR_LOG_LEVEL=info

# JSONL decision log written by the proxy and served at /api/logs.
# KORVYR_LOG_FILE=proxy/logs.jsonl
