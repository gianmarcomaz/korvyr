FROM python:3.11-slim

WORKDIR /app

# Install system dependencies required for building tree-sitter and PyTorch
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy packaging files
COPY pyproject.toml .

# Install Python dependencies
# We use the [server] optional dependencies
RUN pip install --no-cache-dir -e .[server]

# Copy the rest of the application
COPY . .

# Environment variables
ENV PORT=8000
ENV MODEL_PATH=/app/checkpoints/best_model.pt
ENV MAX_WORKERS=4

# Expose the API port
EXPOSE 8000

# Start the FastAPI server
CMD ["uvicorn", "supplyguard.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
